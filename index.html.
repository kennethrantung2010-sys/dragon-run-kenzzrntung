<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Dragon Run by KenzzRntung</title>
<style>
  :root { color-scheme: dark; }
  * { box-sizing: border-box; }
  body {
    margin: 0; min-height: 100vh; display: grid; place-items: center;
    background: radial-gradient(ellipse at 50% 0%, #263e72 0%, #10182f 52%, #080d1b 100%);
    color: #f4f7ff; font-family: system-ui, sans-serif; padding: 14px;
  }
  .game-wrap { width: min(960px, 100%); }
  header { display:flex; justify-content:space-between; align-items:center; gap:12px; margin:0 2px 10px; }
  h1 { font-size: clamp(20px,4vw,30px); margin:0; letter-spacing:1px; }
  .sub { color:#a9bddf; font-size:12px; margin-top:3px; }
  .pill { border:1px solid #5376a9; background:#17294b; padding:7px 12px; border-radius:99px; font-size:12px; }
  canvas { width:100%; height:auto; display:block; border:1px solid #5275a8; border-radius:18px; background:#101d38; box-shadow:0 18px 55px #0009; touch-action: manipulation; }
  .intro-screen {
    position:relative; min-height:min(420px,60vw); height:420px; overflow:hidden;
    display:grid; place-items:center; border:1px solid #5275a8; border-radius:18px;
    background:radial-gradient(ellipse at 50% 45%,#315d91 0%,#18294f 45%,#090f22 100%);
    box-shadow:0 18px 55px #0009;
  }
  .intro-screen::before,.intro-screen::after {
    content:""; position:absolute; width:280px; height:280px; border:1px solid #7bdedb55;
    border-radius:50%; animation:orbit 14s linear infinite;
  }
  .intro-screen::after { width:390px; height:390px; animation-duration:22s; border-color:#a58cff33; }
  .intro-stars { position:absolute; inset:0; opacity:.7;
    background-image:radial-gradient(#fff 1px,transparent 1.5px),radial-gradient(#8eeaff 1px,transparent 1.5px);
    background-size:57px 57px,91px 91px; background-position:0 0,24px 31px; }
  .intro-content { position:relative; z-index:1; text-align:center; padding:20px; }
  .intro-dragon { font-size:clamp(54px,10vw,88px); filter:drop-shadow(0 0 18px #49f5d6); animation:float 2.4s ease-in-out infinite; }
  .intro-kicker { color:#9bd7ff; font-size:11px; letter-spacing:5px; font-weight:800; margin-top:3px; }
  .intro-name { font-size:clamp(30px,7vw,54px); font-weight:1000; letter-spacing:1px;
    background:linear-gradient(90deg,#fff,#79f5dc,#9eafff); color:transparent; background-clip:text; }
  .intro-line { width:110px; height:3px; margin:10px auto 13px; border-radius:9px; background:linear-gradient(90deg,#53e5d0,#8c83ff); }
  .intro-title { font-size:clamp(19px,4vw,28px); font-weight:950; letter-spacing:6px; }
  .intro-tagline { color:#b7c9e8; font-size:10px; letter-spacing:3px; margin:7px 0 22px; }
  .start-button { min-width:190px; padding:14px 30px; border-radius:999px; border:1px solid #9df8e9;
    background:linear-gradient(100deg,#0cb99e,#347ce8,#7656df); box-shadow:0 0 28px #42d9d188;
    font-size:16px; letter-spacing:2px; }
  .intro-credit { margin-top:18px; font-size:9px; letter-spacing:3px; color:#8199bf; }
  @keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-13px)} }
  @keyframes orbit { to{transform:rotate(360deg)} }
  .hidden { display:none !important; }
  .gameover {
    position:absolute; inset:0; display:grid; place-items:center; text-align:center;
    background:rgba(5,10,25,.78); border-radius:18px; z-index:4;
  }
  .gameover-card { padding:24px; border:1px solid #ff8b8b88; border-radius:18px;
    background:linear-gradient(145deg,#18284a,#351d3c); box-shadow:0 0 35px #ff525244; }
  .gameover h2 { margin:0 0 8px; color:#ff9b9b; letter-spacing:3px; }
  .controls { display:flex; flex-wrap:wrap; gap:9px; margin-top:12px; align-items:center; }
  button { border:0; border-radius:12px; padding:12px 16px; color:white; font-weight:800; font-size:14px; background:linear-gradient(135deg,#2875d8,#654de0); box-shadow:0 5px 0 #172c66; }
  button:active { transform:translateY(2px); box-shadow:0 3px 0 #172c66; }
  #flight.on { background:linear-gradient(135deg,#00a98f,#2677cb); box-shadow:0 5px 0 #075a63; }
  .hint { color:#a9bddf; font-size:12px; line-height:1.5; margin:10px 3px 0; }
  .stat { margin-left:auto; color:#d9e6ff; font-size:12px; }
  @media(max-width:520px){ .controls button{flex:1; padding:13px 8px;} .stat{width:100%; margin-left:2px;} }
</style>
</head>
<body>
<div class="game-wrap">
  <header>
    <div><h1>🐉 DRAGON RUN</h1><div class="sub">Lari, terbang, dan tak terkalahkan!</div></div>
    <div class="pill">∞ NYAWA</div>
  </header>
  <div id="intro" class="intro-screen">
    <div class="intro-stars"></div>
    <div class="intro-content">
      <div class="intro-dragon">🐉</div>
      <div class="intro-kicker">A GAME BY</div>
      <div class="intro-name">KenzzRntung</div>
      <div class="intro-line"></div>
      <div class="intro-title">DRAGON RUN</div>
      <div class="intro-tagline">RISE ABOVE. FLY BEYOND.</div>
      <button id="startGame" class="start-button">▶ MULAI</button>
      <div class="intro-credit">CREATED WITH PASSION</div>
    </div>
  </div>
  <canvas id="game" width="960" height="420" aria-label="Game Dragon Run"></canvas>
  <div class="controls">
    <button id="flight">✈ TERBANG: OFF</button>
    <button id="invincible">🛡 KEBAL: OFF</button>
    <button id="jump">⬆ LOMPAT</button>
    <button id="speed">⚡ TURBO: ON</button>
    <button id="restart">↻ ULANGI</button>
    <span class="stat" id="score">Jarak: 0 m</span>
  </div>
  <p class="hint">Kontrol: tekan <b>TERBANG ON/OFF</b> untuk mengaktifkan sayap. Saat terbang, sentuh layar atau tekan spasi untuk naik. Saat tidak terbang, gunakan LOMPAT. Bisa dimainkan di HP maupun komputer. Naga tidak bisa mati dan rintangan akan dilewati otomatis.</p>
</div>
<script>
(() => {
 const canvas=document.getElementById('game'), ctx=canvas.getContext('2d');
 const intro=document.getElementById('intro');
 const startButton=document.getElementById('startGame');
 canvas.classList.add('hidden');
 document.querySelector('.controls').classList.add('hidden');
 document.querySelector('.hint').classList.add('hidden');
 let started=false;
 startButton.addEventListener('click',()=>{
   if(started) return;
   started=true;
   intro.classList.add('hidden');
   canvas.classList.remove('hidden');
   document.querySelector('.controls').classList.remove('hidden');
   document.querySelector('.hint').classList.remove('hidden');
 });
 const flightBtn=document.getElementById('flight'), jumpBtn=document.getElementById('jump');
 const invincibleBtn=document.getElementById('invincible');
 const speedBtn=document.getElementById('speed'), scoreEl=document.getElementById('score');
 let flying=false, landing=false, invincible=false, turbo=true, frame=0, distance=0;
 let dragonY=0, vy=0, obstacles=[], clouds=[], gameOver=false;
 const ground=340;
 for(let i=0;i<9;i++) clouds.push({x:i*145+Math.random()*60,y:35+Math.random()*135,s:.6+Math.random()*.8});
 function toggleFlight(){
   if(gameOver) return;
   if(!flying && !landing){
     flying=true;
     dragonY=Math.max(dragonY,92);
     vy=0;
   } else {
     flying=false;
     landing=true;
     vy=0;
   }
   flightBtn.textContent='✈ TERBANG: '+(flying?'ON':'OFF');
   flightBtn.classList.toggle('on',flying);
 }
 flightBtn.addEventListener('click',toggleFlight);
 invincibleBtn.addEventListener('click',()=>{
   invincible=!invincible;
   invincibleBtn.textContent='🛡 KEBAL: '+(invincible?'ON':'OFF');
   invincibleBtn.classList.toggle('on',invincible);
 });
 speedBtn.addEventListener('click',()=>{turbo=!turbo;speedBtn.textContent='⚡ TURBO: '+(turbo?'ON':'OFF');});
 function jump(){
   if(gameOver) return;
   if(flying){vy=8;}
   else if(!landing && dragonY===0){vy=13;}
 }
 jumpBtn.addEventListener('click',jump);
 document.addEventListener('keydown',e=>{
   if(e.code==='Space'||e.code==='ArrowUp'){e.preventDefault();jump();}
   if(e.code==='ArrowDown' && flying) vy=-7;
   if(e.code==='KeyF')toggleFlight();
 });
 canvas.addEventListener('pointerdown',jump);
 function resetGame(){
   frame=0;distance=0;obstacles=[];dragonY=0;vy=0;gameOver=false;
   flying=false;landing=false;invincible=false;
   flightBtn.textContent='✈ TERBANG: OFF';flightBtn.classList.remove('on');
   invincibleBtn.textContent='🛡 KEBAL: OFF';invincibleBtn.classList.remove('on');
 }
 document.getElementById('restart').addEventListener('click',resetGame);
 function roundedRect(x,y,w,h,r){ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill();}
 function drawBackground(){
   let g=ctx.createLinearGradient(0,0,0,420);g.addColorStop(0,'#101b3b');g.addColorStop(.55,'#294b78');g.addColorStop(1,'#f18b72');ctx.fillStyle=g;ctx.fillRect(0,0,960,420);
   // moon and stars
   ctx.fillStyle='#fff1bd';ctx.beginPath();ctx.arc(790,85,35,0,Math.PI*2);ctx.fill();
   ctx.fillStyle='#243d68';ctx.beginPath();ctx.arc(805,73,31,0,Math.PI*2);ctx.fill();
   for(let i=0;i<45;i++){let x=(i*173+frame*.12)%960,y=(i*71)%190;ctx.fillStyle=`rgba(255,255,255,${.25+(i%4)*.15})`;ctx.fillRect(x,y,2,2);}
   // distant mountains
   ctx.fillStyle='#26395f';ctx.beginPath();ctx.moveTo(0,300);for(let x=0;x<=960;x+=80)ctx.lineTo(x,220+Math.sin(x*.018)*48);ctx.lineTo(960,360);ctx.lineTo(0,360);ctx.fill();
   ctx.fillStyle='#182c4b';ctx.beginPath();ctx.moveTo(0,330);for(let x=0;x<=960;x+=65)ctx.lineTo(x,270+Math.sin(x*.025+2)*35);ctx.lineTo(960,370);ctx.lineTo(0,370);ctx.fill();
   clouds.forEach(c=>{ctx.fillStyle='rgba(225,239,255,.25)';ctx.beginPath();ctx.ellipse(c.x,c.y,35*c.s,12*c.s,0,0,Math.PI*2);ctx.ellipse(c.x+22*c.s,c.y-7*c.s,25*c.s,14*c.s,0,0,Math.PI*2);ctx.fill();c.x-=.35*c.s;if(c.x<-70)c.x=1030;});
   ctx.fillStyle='#12253b';ctx.fillRect(0,ground,960,80);
   ctx.fillStyle='#39b7a1';ctx.fillRect(0,ground,960,5);
   ctx.strokeStyle='rgba(133,222,201,.25)';ctx.lineWidth=2;
   for(let x=-(frame* (turbo?9:5))%60;x<960;x+=60){ctx.beginPath();ctx.moveTo(x,ground+24);ctx.lineTo(x+25,ground+24);ctx.stroke();}
 }
 function drawDragon(){
   const run=Math.sin(frame*.42), bob=(dragonY===0&&!flying&&!landing)?Math.abs(run)*2:0;
   const y=ground-70-dragonY-bob, x=155;
   ctx.save();ctx.translate(x,y);
   // Long armored tail and pointed tail blade
   ctx.fillStyle='#152d45';ctx.strokeStyle='#42e6cf';ctx.lineWidth=3;
   ctx.beginPath();ctx.moveTo(-25,8);ctx.quadraticCurveTo(-65,22+run*3,-91,-5);ctx.quadraticCurveTo(-62,5,-42,-12);ctx.closePath();ctx.fill();ctx.stroke();
   ctx.fillStyle='#ff6b42';ctx.beginPath();ctx.moveTo(-91,-5);ctx.lineTo(-111,-17);ctx.lineTo(-103,1);ctx.closePath();ctx.fill();
   // Huge bat wings, animated when flying and lightly moving while running
   const flap=Math.sin(frame*.28)*(flying?24:8);
   ctx.fillStyle='#10243d';ctx.strokeStyle='#27d9c6';ctx.lineWidth=3;
   ctx.beginPath();ctx.moveTo(-13,-12);ctx.lineTo(-55,-78-flap);ctx.lineTo(-47,-43-flap*.4);ctx.lineTo(-83,-58-flap);ctx.lineTo(-61,-17);ctx.lineTo(-30,9);ctx.closePath();ctx.fill();ctx.stroke();
   ctx.beginPath();ctx.moveTo(1,-13);ctx.lineTo(38,-82+flap);ctx.lineTo(34,-43+flap*.4);ctx.lineTo(76,-62+flap);ctx.lineTo(53,-17);ctx.lineTo(25,9);ctx.closePath();ctx.fill();ctx.stroke();
   // Wing veins
   ctx.strokeStyle='#4b8caa';ctx.lineWidth=2;
   ctx.beginPath();ctx.moveTo(-13,-12);ctx.lineTo(-55,-78-flap);ctx.moveTo(-13,-12);ctx.lineTo(-83,-58-flap);ctx.moveTo(1,-13);ctx.lineTo(38,-82+flap);ctx.moveTo(1,-13);ctx.lineTo(76,-62+flap);ctx.stroke();
   // Muscular body with plated belly
   const body=ctx.createLinearGradient(-5,-28,12,28);body.addColorStop(0,'#47f0cf');body.addColorStop(.42,'#087e83');body.addColorStop(1,'#102a46');
   ctx.fillStyle=body;ctx.beginPath();ctx.ellipse(0,0,43,25,-.08,0,Math.PI*2);ctx.fill();
   ctx.strokeStyle='#8effe3';ctx.lineWidth=2;ctx.beginPath();ctx.ellipse(0,0,43,25,-.08,0,Math.PI*2);ctx.stroke();
   // Back spikes
   for(let i=0;i<5;i++){let sx=-25+i*14;ctx.fillStyle=i%2?'#ff874c':'#d7f7ef';ctx.beginPath();ctx.moveTo(sx-5,-15);ctx.lineTo(sx,-31-(i%2)*5);ctx.lineTo(sx+6,-15);ctx.closePath();ctx.fill();}
   // Neck, fierce head and jaw
   ctx.strokeStyle='#18bcae';ctx.lineWidth=20;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(23,-8);ctx.lineTo(38,-29);ctx.stroke();
   ctx.fillStyle='#25d9bb';ctx.beginPath();ctx.ellipse(48,-34,25,17,-.12,0,Math.PI*2);ctx.fill();
   ctx.fillStyle='#087d86';ctx.beginPath();ctx.ellipse(55,-23,19,7,.08,0,Math.PI*2);ctx.fill();
   // Crown horns
   ctx.fillStyle='#f2e5c5';
   [[31,-44,20,-66,43,-47],[48,-48,53,-74,61,-44],[59,-44,76,-62,70,-38]].forEach(a=>{ctx.beginPath();ctx.moveTo(a[0],a[1]);ctx.lineTo(a[2],a[3]);ctx.lineTo(a[4],a[5]);ctx.closePath();ctx.fill();});
   // Glowing angry eye and brow
   ctx.strokeStyle='#10243d';ctx.lineWidth=5;ctx.beginPath();ctx.moveTo(47,-43);ctx.lineTo(64,-39);ctx.stroke();
   ctx.fillStyle='#fff';ctx.beginPath();ctx.ellipse(54,-39,5,3,0,0,Math.PI*2);ctx.fill();
   ctx.fillStyle='#ff3d35';ctx.beginPath();ctx.arc(56,-39,2.5,0,Math.PI*2);ctx.fill();
   // nostril and teeth
   ctx.fillStyle='#10243d';ctx.beginPath();ctx.arc(69,-31,2,0,Math.PI*2);ctx.fill();
   ctx.fillStyle='#fff4df';ctx.beginPath();ctx.moveTo(58,-22);ctx.lineTo(62,-14);ctx.lineTo(65,-22);ctx.fill();
   // Powerful legs animate while on the ground
   ctx.strokeStyle='#087e83';ctx.lineWidth=10;ctx.lineCap='round';
   ctx.beginPath();ctx.moveTo(-17,15);ctx.lineTo(-22+run*7,29);ctx.moveTo(18,14);ctx.lineTo(22-run*7,29);ctx.stroke();
   ctx.strokeStyle='#b5fff0';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(-26+run*7,29);ctx.lineTo(-14+run*7,29);ctx.moveTo(18-run*7,29);ctx.lineTo(30-run*7,29);ctx.stroke();
   // Fiery breath
   ctx.fillStyle='#ff5a36';ctx.beginPath();ctx.moveTo(70,-28);ctx.quadraticCurveTo(91,-42,112,-25);ctx.quadraticCurveTo(97,-20,109,-10);ctx.quadraticCurveTo(84,-12,70,-24);ctx.fill();
   ctx.fillStyle='#ffd36a';ctx.beginPath();ctx.moveTo(72,-26);ctx.quadraticCurveTo(91,-33,101,-24);ctx.quadraticCurveTo(88,-19,72,-26);ctx.fill();
   ctx.restore();
 }
 function spawn(){if(frame%Math.max(35,turbo?48:75)===0)obstacles.push({x:1000,h:35+Math.random()*35,w:25+Math.random()*15});}
 function drawObstacle(o){
   // Kaktus hijau bergaya gurun, dengan batang dan dua cabang berduri.
   const x=o.x, base=ground, h=o.h;
   ctx.fillStyle='#168b55';
   roundedRect(x+8,base-h,18,h,8);
   roundedRect(x-2,base-h+14,12,11,5);
   roundedRect(x-2,base-h+5,9,20,5);
   roundedRect(x+22,base-h+22,12,10,5);
   roundedRect(x+25,base-h+12,9,21,5);
   ctx.fillStyle='#7bf0a0';
   ctx.fillRect(x+12,base-h+8,3,h-15);
   ctx.fillRect(x+2,base-h+9,2,11);
   ctx.fillRect(x+28,base-h+17,2,13);
 }
 function loop(){
   if(!started){requestAnimationFrame(loop);return;}
   if(gameOver){
     drawBackground();obstacles.forEach(drawObstacle);drawDragon();
     ctx.fillStyle='rgba(5,8,20,.72)';ctx.fillRect(0,0,960,420);
     ctx.textAlign='center';ctx.fillStyle='#ffaaa0';ctx.font='900 42px system-ui';ctx.fillText('GAME OVER',480,190);
     ctx.fillStyle='#fff';ctx.font='bold 18px system-ui';ctx.fillText('Tekan ULANGI untuk bermain lagi',480,230);ctx.textAlign='left';
     requestAnimationFrame(loop);return;
   }
   frame++;let pace=turbo?10:5;distance+=pace*.035;drawBackground();spawn();
   obstacles.forEach(o=>{o.x-=pace;drawObstacle(o);});
   obstacles=obstacles.filter(o=>o.x>-80);
   // Flight ON: the dragon stays airborne; jump raises it, down arrow lowers it.
   if(flying){
     dragonY=Math.max(55,Math.min(220,dragonY+vy));
     vy*=.86;if(Math.abs(vy)<.25)vy=0;
   } else if(landing){
     // Flight OFF: descend smoothly all the way to the ground, then run normally.
     dragonY=Math.max(0,dragonY-5);
     if(dragonY===0){landing=false;vy=0;}
   } else if(dragonY>0 || vy>0){
     // Ordinary ground jump with gravity.
     dragonY=Math.max(0,dragonY+vy);
     vy-=.68;if(dragonY===0)vy=0;
   }
   // Cactus collision: only the KEBAL switch protects the dragon.
   for(const o of obstacles){
     const overlapsX=o.x<205 && o.x+36>125;
     const overlapsY=dragonY < o.h+20;
     if(overlapsX && overlapsY && !invincible){gameOver=true;break;}
   }
   drawDragon();
   ctx.fillStyle='rgba(255,255,255,.95)';ctx.font='bold 15px system-ui';
   ctx.fillText(landing?'MODE MENDARAT':(flying?'MODE TERBANG':'MODE LARI'),22,30);
   ctx.fillStyle=invincible?'#7dffcb':'#fff';ctx.font='bold 17px system-ui';
   ctx.fillText(invincible?'KEBAL AKTIF':'KEBAL NONAKTIF',22,57);
   scoreEl.textContent='Jarak: '+Math.floor(distance)+' m';
   requestAnimationFrame(loop);
 }
 loop();
})();
</script>
</body>
</html>